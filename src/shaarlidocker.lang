# ===========================================================================
# Multilingual file for the TOS 7 Docker application "shaarlidocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language.
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations". run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Shaarli"
auth         = "shaarli"
version      = "@@VERSION@@"
descript     = "Shaarli is a single-user, self-hosted bookmark manager: save links with a title, description and tags, mark them public or private, search them, browse by tag, date, daily/weekly page or picture wall, and publish RSS/ATOM feeds of public links. It can fetch the title, description and an optional thumbnail from the page you save, supports plugins, and imports/exports Netscape bookmarks. Data lives in flat files in the application data folder - no database server."
release_note = "0.16.11-1: remediated the listing review. Upgraded the upstream image to 0.16.11, which fixes the LDAP empty-password issue (GHSA-xqxc-g4w2-w7vv), CVE-2026-118773 in a bundled npm dependency and refreshes the Alpine base. Fixed the container: the data folder was mounted at a path Shaarli never writes to, and the cache/pagecache/tmp folders were not writable at all, so bookmarks and settings were lost on restart and the web UI could not finish installation. All four now point at the paths Shaarli uses. Added a router so /install, /login, /admin and /shaare/... work with the built-in PHP server. Added a privacy policy and third-party API disclosure, rewrote the descriptions, and completed the README, changelog and licence notice."
important    = "Requires DockerEngine. Open http://<NAS-IP>:8176 to create the admin account on first visit. Bookmarks, settings and thumbnails live in /Volume1/DockerAppData/shaarlidocker/ and survive restarts and updates. Runs as uid 1000. Saving a link may fetch that page and its images. The admin UI checks GitHub for a new Shaarli release once a day. Privacy policy: see the Help link. Plain HTTP - use a TLS reverse proxy before exposing it to the internet."

[zh-cn]
name         = "Shaarli"
auth         = "shaarli"
version      = "@@VERSION@@"
descript     = "Shaarli 是单用户的自建书签管理器：保存链接并添加标题、描述和标签，可设为公开或私有，支持搜索、按标签浏览、按日期/每日/每周归档浏览，并为公开书签提供 RSS/ATOM 订阅。保存链接时可抓取目标网页的标题、描述和缩略图（缩略图需在设置中开启），支持可选插件，支持导入/导出 Netscape 书签。数据以平面文件保存在应用数据目录，无需数据库服务。"
release_note = "0.16.11-1：按上轮审核意见整改。上游镜像升级到 0.16.11（安全修复：拒绝 LDAP 空密码、修复随镜像分发的 npm 依赖 CVE-2026-118773）。修复容器：原先数据目录挂载到 Shaarli 并不使用的路径，缓存/页面缓存/模板目录也不可写，导致书签与设置在重启后丢失、网页界面无法完成安装；现已把四个目录挂载到 Shaarli 实际使用的路径。新增 HTTP 路由，使 /install、/login、/admin 在内置 PHP 服务器下可用。新增隐私政策与第三方接口披露，重写描述，补全 README、CHANGELOG 与许可证声明。"
important    = "需要 DockerEngine。首次访问 http://<NAS-IP>:8176 创建管理员账号。书签、设置与缩略图保存在 /Volume1/DockerAppData/shaarlidocker/，重启与升级不会丢失。容器以 uid 1000 运行。保存链接时可能访问该网页及其图片；管理员界面每天会向 GitHub 检查一次新版本。隐私政策见帮助链接。界面为纯 HTTP，暴露到公网前请配置带 TLS 的反向代理。"

[zh-hk]
name         = "Shaarli"
auth         = "shaarli"
version      = "@@VERSION@@"
descript     = "Shaarli 是單一使用者的自建書籤管理器：儲存連結並加入標題、描述和標籤，可設為公開或私有，支援搜尋、按標籤瀏覽、按日期/每日/每週歸檔瀏覽，並為公開書籤提供 RSS/ATOM 訂閱。儲存連結時可抓取目標網頁的標題、描述和縮圖（縮圖需在設定中開啟），支援可選外掛，支援匯入/匯出 Netscape 書籤。資料以平面檔案儲存在應用資料目錄，無需資料庫服務。"
release_note = "0.16.11-1：依上輪審核意見整改。上游映像升級到 0.16.11（安全修復：拒絕 LDAP 空密碼、修復隨映像散佈的 npm 依賴 CVE-2026-118773）。修復容器：原先資料目錄掛載到 Shaarli 並不使用的路徑，快取/頁面快取/模板目錄也不可寫，導致書籤與設定在重新啟動後遺失、網頁介面無法完成安裝；現已把四個目錄掛載到 Shaarli 實際使用的路徑。新增 HTTP 路由，使 /install、/login、/admin 在內建 PHP 伺服器下可用。新增隱私政策與第三方介面披露，重寫描述，補全 README、CHANGELOG 與授權聲明。"
important    = "需要 DockerEngine。首次存取 http://<NAS-IP>:8176 建立管理員帳號。書籤、設定與縮圖保存在 /Volume1/DockerAppData/shaarlidocker/，重新啟動與升級不會遺失。容器以 uid 1000 執行。儲存連結時可能存取該網頁及其圖片；管理員介面每天會向 GitHub 檢查一次新版本。隱私政策見說明連結。介面為純 HTTP，公開到互聯網前請配置帶 TLS 的反向代理。"

[fr-fr]
name         = "Shaarli"
auth         = "shaarli"
version      = "@@VERSION@@"
descript     = "Shaarli is a single-user, self-hosted bookmark manager: save links with a title, description and tags, mark them public or private, search them, browse by tag, date, daily/weekly page or picture wall, and publish RSS/ATOM feeds of public links. It can fetch the title, description and an optional thumbnail from the page you save, supports plugins, and imports/exports Netscape bookmarks. Data lives in flat files in the application data folder - no database server."
release_note = "0.16.11-1: remediated the listing review. Upgraded the upstream image to 0.16.11, which fixes the LDAP empty-password issue (GHSA-xqxc-g4w2-w7vv), CVE-2026-118773 in a bundled npm dependency and refreshes the Alpine base. Fixed the container: the data folder was mounted at a path Shaarli never writes to, and the cache/pagecache/tmp folders were not writable at all, so bookmarks and settings were lost on restart and the web UI could not finish installation. All four now point at the paths Shaarli uses. Added a router so /install, /login, /admin and /shaare/... work with the built-in PHP server. Added a privacy policy and third-party API disclosure, rewrote the descriptions, and completed the README, changelog and licence notice."
important    = "Requires DockerEngine. Open http://<NAS-IP>:8176 to create the admin account on first visit. Bookmarks, settings and thumbnails live in /Volume1/DockerAppData/shaarlidocker/ and survive restarts and updates. Runs as uid 1000. Saving a link may fetch that page and its images. The admin UI checks GitHub for a new Shaarli release once a day. Privacy policy: see the Help link. Plain HTTP - use a TLS reverse proxy before exposing it to the internet."

