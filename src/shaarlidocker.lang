# ===========================================================================
# Multilingual file for the TOS 7 Docker application "shaarlidocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Shaarli"
auth         = "shaarli"
version      = "@@VERSION@@"
descript     = "Shaarli is a personal bookmarking service: save links with tags and descriptions, search your archive, browse by tag or date, import/export from other bookmark managers and publish a public or private feed. It runs on flat files in the application data folder - no database server needed."
release_note = "1. First release: Shaarli 0.16.10 from Docker Hub as a non-root container. Self-hosted bookmarks with tags, search and feeds; data in the application data folder."
important    = "Requires DockerEngine (installed automatically if missing). The first visit asks you to set the admin login, timezone and language; bookmarks and configuration live in DockerAppData/shaarlidocker/data. Plain HTTP; use a TLS reverse proxy before exposing it to the internet."

[zh-cn]
name         = "Shaarli"
auth         = "shaarli"
version      = "@@VERSION@@"
descript     = "Shaarli 是自建书签服务：保存带标签和描述的链接、搜索归档、按标签或日期浏览，支持从其它书签工具导入/导出，并能发布公开或私有 feed。它用应用数据目录里的平面文件存储，不需要数据库服务。"
release_note = "1. 首个版本：基于 Docker Hub 的 Shaarli 0.16.10，以非 root 容器运行。自建书签，支持标签、搜索与 feed；数据保存在应用数据目录。"
important    = "需要 DockerEngine（缺失时应用中心会自动安装）。首次访问会让你设置管理员账号、时区与语言；书签与配置都保存在 DockerAppData/shaarlidocker/data。界面为纯 HTTP，暴露到公网前请配置带 TLS 的反向代理。"

[zh-hk]
name         = "Shaarli"
auth         = "shaarli"
version      = "@@VERSION@@"
descript     = "Shaarli 是自建書籤服務：儲存帶標籤和描述的連結、搜尋歸檔、按標籤或日期瀏覽，支援從其它書籤工具匯入/匯出，並能發佈公開或私有 feed。它用應用資料目錄裡的平面檔案儲存，不需要資料庫服務。"
release_note = "1. 首個版本：基於 Docker Hub 的 Shaarli 0.16.10，以非 root 容器運行。自建書籤，支援標籤、搜尋與 feed；資料保存在應用資料目錄。"
important    = "需要 DockerEngine（缺少時應用中心會自動安裝）。首次存取會讓你設定管理員帳號、時區與語言；書籤與設定都保存在 DockerAppData/shaarlidocker/data。介面為純 HTTP，公開到互聯網前請配置帶 TLS 的反向代理。"

